{{-- محرك الـ AJAX والطباعة الذكي --}}
<script>
let globalAttendanceData = []; // تخزين مؤقت للبيانات من أجل وظيفة الطباعة
let searchTimeout = null;

document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('smartSearch');
    const loader = document.getElementById('searchLoader');
    const container = document.getElementById('cardsContainer');

    searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim();

        // مسح التايم آوت السابق (Debounce) لمنع إرسال طلبات متتالية مع كل حرف سريع
        clearTimeout(searchTimeout);

        if (query.length < 3) {
            container.innerHTML = `
                <div class="text-center text-gray-400 py-12 bg-white rounded-xl border border-dashed">
                    🔍 يرجى كتابة 3 أحرف على الأقل لبدء البحث...
                </div>`;
            globalAttendanceData = [];
            return;
        }

        // تأخير الطلب 400 مللي ثانية للتأكد من توقف الأستاذ عن الكتابة
        searchTimeout = setTimeout(() => {
            loader.classList.remove('hidden');

            // إرسال طلب AJAX إلى السيرفر مجاناً وبخفة
            fetch(`{{ route('registration.attendance-search') }}?term=${encodeURIComponent(query)}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                loader.classList.add('hidden');
                globalAttendanceData = data; // حفظ البيانات للطباعة
                
                if (data.length === 0) {
                    container.innerHTML = `
                        <div class="text-center text-red-500 py-12 bg-white rounded-xl border">
                            😞 لم يتم العثور على أي مواد مطابقة للبحث المكتوب.
                        </div>`;
                    return;
                }

                // بناء كود الـ HTML للكروت ديناميكياً داخل المتصفح
                let html = '';
                data.forEach(item => {
                    let teachersText = item.teachers.length > 0 
                        ? item.teachers.map(t => `${t.name} (${t.role})`).join(' - ')
                        : '<span class="text-red-500">لم يتم توزيع مدرس بعد</span>';

                    let studentRows = '';
                    if (item.students.length > 0) {
                        item.students.forEach((student, index) => {
                            studentRows += `
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="border px-3 py-2 text-center">${index + 1}</td>
                                    <td class="border px-3 py-2 text-center">${student.student_number}</td>
                                    <td class="border px-3 py-2 text-right">${student.name}</td>
                                    <td class="border px-3 py-2 text-right">${student.department_name}</td>
                               
                                </tr>`;
                        });
                    } else {
                        studentRows = `<tr><td colspan="7" class="text-center py-4 text-gray-500">لا يوجد طلاب مسجلين في هذه المادة.</td></tr>`;
                    }

                    html += `
                        <div class="bg-white rounded-xl shadow-sm border p-4">
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 border-b pb-3 gap-2">
                                <div>
                                    <h2 class="font-bold text-xl text-gray-800">${item.course_name}</h2>
                                    <div class="text-sm text-gray-600 mt-1"><strong>المدرس:</strong> ${teachersText}</div>
                                </div>
                                <div class="text-gray-600 text-sm flex flex-wrap gap-3">
                                    <span><strong>الشعبة:</strong> ${item.section_name}</span>
                                    <span><strong>الفصل:</strong> (${item.semester_year}) - ${item.semester_type}</span>
                                </div>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="min-w-full text-sm border-collapse border border-gray-200">
                                    <thead class="bg-gray-100 text-gray-700">
                                        <tr>
                                            <th class="border px-3 py-2 text-center">#</th>
                                            <th class="border px-3 py-2 text-center">رقم الطالب</th>
                                            <th class="border px-3 py-2 text-right">الاسم</th>
                                            <th class="border px-3 py-2 text-right">القسم</th>
                                        
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">${studentRows}</tbody>
                                </table>
                            </div>
                        </div>`;
                });

                container.innerHTML = html;
            })
            .catch(error => {
                loader.classList.add('hidden');
                console.error('Error:', error);
            });
        }, 400);
    });
});

function printTable() {
    if (globalAttendanceData.length === 0) {
        alert('لا توجد بيانات معروضة حالياً لطباعتها! يرجى البحث أولاً.');
        return;
    }

    let tableHtml = '';

    // المرور على البيانات المجلوبة من الـ AJAX لطباعتها بنفس التنسيق بضبط
    globalAttendanceData.forEach(item => {
        let tableContent = '';

        if (item.students.length === 0) {
            tableContent = '<p>لا يوجد طلاب مسجلين</p>';
        } else {
            tableContent = `
                <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
                    <thead>
                        <tr>
                            <th rowspan="2">ت.ر</th>
                            <th rowspan="2">اسم الطالب</th>
                            <th rowspan="2">رقم القيد</th>
                            <th rowspan="2">القسم</th>
                            <th colspan="17">الأسبوع رقم</th>
                        </tr>
                        <tr>
                            ${Array.from({length: 17}, (_, i) => `<th>${i + 1}</th>`).join('')}
                        </tr>
                    </thead>
                    <tbody>
                        ${item.students.map((student, index) => `
                            <tr>
                                <td>${index + 1}</td>
                                <td>${student.name}</td>
                                <td>${student.student_number}</td>
                                <td>${student.department_name}</td>
                                ${Array.from({length: 17}, () => `<td></td>`).join('')}
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        // بناء نفس بنية الترويسة والمعلومات بضبط كما في دالتك الأصلية
        tableHtml += `
            <div style="margin-bottom: 40px;">
                <!-- الترويسة -->
                <div style="display: flex; justify-content: space-between; font-family: Arial, sans-serif; margin-bottom: 10px;">
                    <div>كشف الحضور والغياب</div>
                </div>
                <div>اسم المادة: ${item.course_name}</div>
                <div> الفصل الدراسي: ${item.semester_type} ${item.semester_year} </div>
                <div>القسم : ${item.section_name}</div>

                ${tableContent}
            </div>
        `;
    });

    const newWin = window.open('', '_blank', 'width=900,height=700');
    newWin.document.write(`
        <html>
            <head>
                <title>نموذج حضور وغياب</title>
                <style>
                    body { font-family: Arial, sans-serif; direction: rtl; margin: 20px; }
                    h1 { text-align: center; margin-bottom: 20px; }
                    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                    th, td { border: 1px solid #ccc; padding: 8px; text-align: center; }
                    th { background-color: #f0f0f0; }
                    @media print {
                        body { margin: 0; }
                        table { page-break-inside: auto; }
                        tr { page-break-inside: avoid; page-break-after: auto; }
                        thead { display: table-header-group; }
                        tfoot { display: table-footer-group; }
                    }
                </style>
            </head>
            <body>
                <h1>    كلية التقنية الهندسية زوارة</h1>
                ${tableHtml}
            </body>
        </html>
    `);
    newWin.document.close();
    newWin.focus();
    
    // تأخير الطباعة أجزاء من الثانية لضمان استقرار النافذة في بعض المتصفحات
    setTimeout(() => {
        newWin.print();
        newWin.close();
    }, 250);
}
</script>
